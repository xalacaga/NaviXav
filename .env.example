# Copier ce fichier vers .env et renseigner les valeurs.
# Tout est également réglable depuis le bouton Paramètres de l'application web.

# --- SimBrief ---------------------------------------------------------------
# Ton Pilot ID SimBrief (Account Settings > SimBrief Pilot ID), ex: 123456
SIMBRIEF_PILOT_ID=
# Alternative : ton alias SimBrief. Utilisé seulement si SIMBRIEF_PILOT_ID est vide.
SIMBRIEF_USERNAME=

# --- Base de navigation -----------------------------------------------------
# La navigation est lue directement dans MSFS par l'API Facilities de
# SimConnect, puis conservée dans data/navixav.sqlite. Ni Navigraph, ni Little
# Navmap. Laisser vide pour l'emplacement par défaut.
NAVDATA_STORE=

# --- Météo ------------------------------------------------------------------
# METAR: simbrief (utilise ceux de l'OFP) | awc (aviationweather.gov) | none
METAR_SOURCE=simbrief

# --- Préférences de sélection ----------------------------------------------
# Ordre de préférence des approches, séparé par des virgules.
APPROACH_PREFERENCE=ILS,GLS,LOC,RNAV,VORDME,VOR,NDBDME,NDB,TACAN,VISUAL
# Qualification RNP de l'avion. Certaines variantes d'une même approche ne
# diffèrent que par là : à LFBO, ILS Z RWY 32R exige le RNP 1 pour son approche
# interrompue, ILS Y RWY 32R non. Un A319/A320/A321 Fenix est RNP 1.
AIRCRAFT_RNP_CAPABLE=true
# Vent arrière maximum accepté (kt) avant forte pénalité
MAX_TAILWIND_KT=10
# Vent traversier maximum accepté (kt)
MAX_CROSSWIND_KT=35
# Longueur de piste minimale (ft) ; 0 = pas de filtre
MIN_RUNWAY_LENGTH_FT=0
# Configurations préférentielles de pistes par aéroport (répartition
# arrivées/départs, antibruit…). Ces règles ne figurent dans aucun cycle AIRAC.
# Laisser vide pour utiliser data/airport_preferences.json.
AIRPORT_PREFERENCES=
